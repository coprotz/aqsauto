AZAMPAY_CALLBACK_URL=https://us-central1-aqssite-6aa5c.cloudfunctions.net/azamPayCallback

# Set these with Firebase Secret Manager, not in this file:
# firebase functions:secrets:set AZAMPAY_ENV
# firebase functions:secrets:set AZAMPAY_APP_NAME
# firebase functions:secrets:set AZAMPAY_CLIENT_ID
# firebase functions:secrets:set AZAMPAY_CLIENT_SECRET
# firebase functions:secrets:set AZAMPAY_API_KEY

# AZAMPAY_ENV should be SANDBOX for sandbox credentials or LIVE for live credentials.
# Do not set AZAMPAY_CHECKOUT_URL unless AzamPay gives you a custom endpoint.
